# Copie para .env (local) ou configure no painel do Render. NUNCA versione o .env real.
DATABASE_URL=postgres://usuario:senha@host:5432/banco
JWT_SECRET=<segredo aleatório com pelo menos 32 bytes>
CORS_ORIGINS=
# Login com Google: o mesmo Client ID "Web" criado no Google Cloud Console.
# Só o Client ID é necessário — o Client Secret NÃO é usado nem deve ser configurado.
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
# Opcional: URL de incorporação do jogo (itch.io). Padrão: https://itch.io/embed-upload/20479421?color=000000
GAME_EMBED_URL=
# Opcional: exibição do jogo. GAME_VIEWPORT_MODE=fluid (padrão) faz o iframe preencher a caixa 16:9.
# Use scaled se o itch.io embute o jogo com tamanho fixo e a imagem aparece cortada; nesse caso GAME_WIDTH/GAME_HEIGHT
# devem ser iguais ao tamanho configurado em "Embed options" do projeto no itch.io (padrão 1920x1080).
GAME_VIEWPORT_MODE=
GAME_WIDTH=
GAME_HEIGHT=
