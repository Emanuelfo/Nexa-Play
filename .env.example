# Copie para .env (local) ou configure no painel do Render. NUNCA versione o .env real.
DATABASE_URL=postgres://usuario:senha@host:5432/banco
JWT_SECRET=<segredo aleatório com pelo menos 32 bytes>
CORS_ORIGINS=
# Login com Google: o mesmo Client ID "Web" criado no Google Cloud Console.
# Só o Client ID é necessário — o Client Secret NÃO é usado nem deve ser configurado.
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
